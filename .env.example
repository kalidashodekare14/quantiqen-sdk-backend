# QUANTIQEN SDK Backend — environment
# Copy to .env for local development. Never commit real values.

# --- Required ---------------------------------------------------------------

# Port the HTTP server listens on (Render injects this automatically).
PORT=3000

# Base URL of the private NestJS platform backend.
# e.g. https://<platform>.onrender.com — the edge forwards /v1/* to
# {NESTJS_BASE_URL}/api/v1/*. Never commit a real internal URL to a public repo.
NESTJS_BASE_URL=http://localhost:3000

# --- Optional (defaults shown) ----------------------------------------------

# Upstream request timeout in milliseconds. Mapped to 504 UPSTREAM_TIMEOUT.
REQUEST_TIMEOUT_MS=10000

# Maximum accepted request body size. A 500-event bulk batch is ~250-500 KB.
# Oversized bodies get 413 PAYLOAD_TOO_LARGE.
MAX_BODY_SIZE=512kb

# Comma-separated CORS allow-list (never "*"). Omit to send no CORS headers —
# the SDKs are server-side clients and do not need CORS.
# CORS_ORIGINS=https://app.quantiqen.com

# Optional service-to-service secret forwarded to NestJS as
# X-Internal-Proxy-Secret so the platform can distinguish edge traffic.
# INTERNAL_PROXY_SECRET=

# Edge per-IP rate limit (generous defense-in-depth; the platform's per-API-key
# limits are authoritative).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
